{
  "name": "breedops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" package.json eslint.config.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/auth.test.ts tests/request-security.test.ts tests/security-headers.test.ts tests/query-state.test.ts tests/user-management.test.ts",
    "test:auth": "vitest run tests/auth.integration.test.ts",
    "test:breeding": "vitest run tests/breeding.integration.test.ts",
    "test:phenotypes": "vitest run tests/phenotypes.integration.test.ts",
    "test:inventory": "vitest run tests/inventory.integration.test.ts",
    "test:operations": "vitest run tests/operations.integration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "local:configure": "node scripts/configure-local.mjs",
    "local:provision-admin": "node scripts/provision-first-admin.mjs",
    "local:reset-password": "node scripts/reset-local-password.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:identity": "node scripts/test-rls.mjs tests/breeding-identity-lifecycle.sql",
    "test:code-concurrency": "node scripts/test-code-concurrency.mjs",
    "security:client-secrets": "node scripts/check-client-secrets.mjs",
    "db:start": "npm exec --yes --package=supabase@2.75.0 -- supabase start -x studio,realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "dependencies": {
    "@hookform/resolvers": "3.4.2",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-table": "8.17.0",
    "date-fns": "3.6.0",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "24.1.1",
    "prettier": "3.3.2",
    "vitest": "4.1.11"
  }
}
