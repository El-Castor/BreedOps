{
  "name": "breedops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" package.json eslint.config.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/auth.test.ts tests/request-security.test.ts tests/security-headers.test.ts tests/query-state.test.ts tests/user-management.test.ts tests/media.test.ts tests/import-export.test.ts tests/import-export-export.test.ts tests/instrumentation.test.ts tests/health.test.ts",
    "test:auth": "vitest run tests/auth.integration.test.ts",
    "test:breeding": "vitest run tests/breeding.integration.test.ts",
    "test:phenotypes": "vitest run tests/phenotypes.integration.test.ts",
    "test:inventory": "vitest run tests/inventory.integration.test.ts",
    "test:operations": "vitest run tests/operations.integration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "local:configure": "node scripts/configure-local.mjs",
    "local:provision-admin": "node scripts/provision-first-admin.mjs",
    "local:reset-password": "node scripts/reset-local-password.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:identity": "node scripts/test-rls.mjs tests/breeding-identity-lifecycle.sql",
    "test:code-concurrency": "node scripts/test-code-concurrency.mjs",
    "test:phenotyping": "node scripts/test-rls.mjs tests/configurable-phenotyping.sql",
    "test:media": "node scripts/test-rls.mjs tests/plant-media.sql",
    "test:workflows": "node scripts/test-rls.mjs tests/experimental-workflows.sql",
    "test:import-export": "node scripts/test-rls.mjs tests/import-export.sql",
    "test:business-completion": "node scripts/test-rls.mjs tests/business-completion.sql",
    "test:auth-rate-limiting": "node scripts/test-rls.mjs tests/auth-rate-limiting.sql",
    "test:audit-logs-cleanup": "node scripts/test-rls.mjs tests/audit-logs-cleanup.sql",
    "media:check-orphans": "node scripts/check-media-orphans.mjs",
    "security:client-secrets": "node scripts/check-client-secrets.mjs",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "app:start": "node scripts/start-app.mjs",
    "app:stop": "node scripts/stop-app.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "dependencies": {
    "@hookform/resolvers": "3.4.2",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-table": "8.17.0",
    "date-fns": "3.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.52.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "24.1.1",
    "prettier": "3.3.2",
    "supabase": "2.121.0",
    "vitest": "4.1.11"
  }
}
